# DeepSeek API Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI Whisper Settings (Official API or Google Colab FastAPI/ngrok)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_CUSTOM_URL=https://your-whisper-endpoint.ngrok-free.dev/transcribe

# Google OAuth 2.0 Credentials (For Google Calendar Read/Write)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth Settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_minimum

# Working Hours Configuration (HH:MM 24-hour format)
NEXT_PUBLIC_WORK_START=09:00
NEXT_PUBLIC_WORK_END=18:00

# ---- OpenCode agent backend (per-user OpenCode sessions, big-pickle model) ----
# Base URL of the OpenCode server started with `opencode serve`.
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Model/provider for the assistant (big-pickle is the default free model).
OPENCODE_PROVIDER=opencode
OPENCODE_MODEL=big-pickle
# Credentials the Next.js server uses to talk to a password-protected `opencode serve`.
# (Leave unset if your serve instance has no auth.)
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# ---- Local data & admin ----
# Overrides the on-disk data root (defaults to ./data).
LIFEOS_DATA_DIR=./data
# Secret the agent tool calls must present via `x-lifeos-admin` (dev header auth).
LIFEOS_ADMIN_SECRET=replace_with_a_long_random_string
# Fallback user id used for agent tool calls in local dev.
LIFEOS_DEV_USER=local-dev-user
# Secret for cron endpoints (`x-lifeos-cron` header). Leave unset to allow open cron in dev.
LIFEOS_CRON_SECRET=replace_with_another_long_random_string

# ---- Reminder pipeline (JITAI) ----
# Quiet window during which no reminders are delivered (24h format).
LIFEOS_QUIET_START=22
LIFEOS_QUIET_END=8
